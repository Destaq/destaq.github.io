{%- comment -%} {% include video id="yOgAxEVGCCg" provider="youtube" %}  (vimeo also works) {%- endcomment -%}
{%- if include.provider == "vimeo" -%}
  {%- assign video_src = "https://player.vimeo.com/video/" | append: include.id -%}
{%- else -%}
  {%- assign video_src = "https://www.youtube-nocookie.com/embed/" | append: include.id -%}
{%- endif -%}
<div class="video"><iframe src="{{ video_src }}" title="{{ include.title | default: 'Video' }}" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
