---
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import WritingList from "@components/WritingList.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Writing" description="Essays, tutorials, and language-learning writing by Simon Ilincev.">
  <section class="field-shell page-intro">
    <SectionHeader
      kicker="Writing"
      title="Essays, launches, and language"
      deck="Writing on language learning, software, self-directed study, and the small tools that make attention easier to keep."
    />
  </section>

  <section class="field-shell">
    <WritingList items={posts} />
  </section>
</PageLayout>
