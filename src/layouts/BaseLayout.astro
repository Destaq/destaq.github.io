---
import "@fontsource/spectral/400.css";
import "@fontsource/spectral/400-italic.css";
import "@fontsource/spectral/500.css";
import "@fontsource/spectral/500-italic.css";
import "@fontsource/spectral/600.css";
import "@fontsource/spectral/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/700.css";
import "../styles/global.css";
import { site } from "@lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: unknown;
  bodyClass?: string;
}

const {
  title = site.name,
  description = site.description,
  image = "/media/profile/simon-profile-square.jpg",
  imageAlt = "Portrait and portfolio image for Simon Ilincev",
  imageWidth,
  imageHeight,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData,
  bodyClass = ""
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const ogImage = new URL(image, site.url).toString();
const inferredImageWidth = imageWidth ?? (image === "/media/profile/simon-profile-square.jpg" ? 840 : 1200);
const inferredImageHeight = imageHeight ?? (image === "/media/profile/simon-profile-square.jpg" ? 840 : 630);
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: site.email,
  jobTitle: "Computer Science student and software engineer",
  alumniOf: "Cornell University",
  sameAs: site.socials.filter((item) => !item.href.startsWith("mailto:")).map((item) => item.href)
};
const jsonLd = structuredData ?? personJsonLd;
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Simon Ilincev Writing" href="/feed.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/site.webmanifest" />
    <link rel="mask-icon" href="/assets/images/safari-pinned-tab.svg" color="#1f1b17" />
    <meta name="theme-color" content="#fbfaf7" data-theme-color />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(inferredImageWidth)} />
    <meta property="og:image:height" content={String(inferredImageHeight)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && <meta property="article:author" content={site.name} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      (() => {
        const key = "simonilincev-theme";
        const validThemes = new Set(["paper", "dusk"]);
        let stored = null;
        try {
          stored = window.localStorage.getItem(key);
        } catch {
          stored = null;
        }
        const preferred = window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dusk" : "paper";
        const theme = validThemes.has(stored) ? stored : preferred;
        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"][data-theme-color]');
        if (themeColor instanceof HTMLMetaElement) {
          themeColor.content = theme === "dusk" ? "#181818" : "#fbfaf7";
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const localHosts = new Set(["localhost", "127.0.0.1", "0.0.0.0", "::1"]);
        if (localHosts.has(window.location.hostname)) {
          return;
        }

        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          window.dataLayer.push(arguments);
        };

        const gtagScript = document.createElement("script");
        gtagScript.async = true;
        gtagScript.src = "https://www.googletagmanager.com/gtag/js?id=G-0M42PJ7MRK";
        document.head.append(gtagScript);

        window.gtag("js", new Date());
        window.gtag("config", "G-0M42PJ7MRK");

        const locadaptStyles = document.createElement("link");
        locadaptStyles.rel = "stylesheet";
        locadaptStyles.href = "https://cdn.locadapt.com/locadapt.min.css";
        document.head.append(locadaptStyles);

        const locadaptScript = document.createElement("script");
        locadaptScript.src = "https://cdn.locadapt.com/locadapt.min.js";
        locadaptScript.dataset.projectId = "69602af3-ecdb-4538-8647-0f4bcc62625c";
        document.head.append(locadaptScript);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
